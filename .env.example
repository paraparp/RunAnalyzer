# ── Strava ───────────────────────────────────────────────────────────────────
VITE_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
VITE_STRAVA_REDIRECT_URI=

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Solo servidor. La usa el MCP para leer user_storage saltando RLS (el usuario ya
# viene verificado por el token OAuth). Database → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── Servidor MCP (OAuth) ─────────────────────────────────────────────────────
# Secreto para firmar los JWT del OAuth (codes / access / refresh / client_id).
# Genera uno largo y aleatorio, p.ej.:  openssl rand -base64 48
MCP_JWT_SECRET=

# ── Proveedores IA (servidor) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
